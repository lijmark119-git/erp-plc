# Example environment for the FastAPI backend
APP_ENV=development
DEBUG=false
DATABASE_URL=postgresql+psycopg2://erp_user:replace-with-a-secure-password@localhost:5432/erp_plc
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_COOKIE_NAME=erp_session
CSRF_COOKIE_NAME=erp_csrf
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=8
